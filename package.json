{
  "name": "office-workflow-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "audit:prod": "pnpm audit --prod",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "playwright": "1.63.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
